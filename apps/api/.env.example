# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Postgres (Drizzle)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/axp

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_RESET_SECRET=change-me-too-a-different-long-random-string
SESSION_COOKIE_NAME=axp_session
SESSION_TTL_DAYS=30
SESSION_TTL_DAYS_REMEMBER_OFF=1

# SMTP (OTP delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=change-me
MAIL_FROM="AXP Mortgage <no-reply@axp.example.com>"

# S3-compatible object storage (AWS S3, R2, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=axp-kyc-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Internal-only endpoint for simulating reviewer decisions (no admin UI is built yet)
INTERNAL_ADMIN_SECRET=change-me-dev-only
